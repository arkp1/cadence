# ---- required ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# openssl rand -base64 48   (never change after launch: it decrypts stored OAuth tokens)
APP_SECRET=
# Google Cloud → Credentials → OAuth client (Web). Redirect URI: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- recommended ----
PUBLIC_URL=http://localhost:3000
CRON_SECRET=

# ---- Outlook / Microsoft 365 (optional). Redirect URI: {PUBLIC_URL}/api/auth/microsoft/callback ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ---- email (optional: Resend or SMTP) ----
# RESEND_API_KEY=re_...
# EMAIL_FROM="Cadence <bookings@yourdomain.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---- Stripe (optional). Webhook: {PUBLIC_URL}/api/stripe/webhook ----
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PORT=3000
